{
  "name": "qnxray",
  "displayName": "QNXray",
  "description": "Live QNX 8.0 scheduling X-ray, priority-inversion detector and AI crash explainer",
  "version": "0.1.0",
  "publisher": "suganthi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qnxray.openDashboard",
        "title": "QNXray: Open Scheduling Dashboard"
      },
      {
        "command": "qnxray.explainCrash",
        "title": "QNXray: Explain Last Crash"
      },
      {
        "command": "qnxray.build",
        "title": "QNXray: Build Current File for QNX"
      },
      {
        "command": "qnxray.timeline",
        "title": "QNXray: Capture Trace Timeline"
      },
      {
        "command": "qnxray.ci",
        "title": "QNXray: Run CI Gate"
      }
    ],
    "configuration": {
      "title": "QNXray",
      "properties": {
        "qnxray.target": {
          "type": "string",
          "default": "mock",
          "description": "'mock', an ssh alias (e.g. qnxvm) or [user@]host[:port] of the QNX target"
        },
        "qnxray.python": {
          "type": "string",
          "default": "python3"
        },
        "qnxray.interval": {
          "type": "number",
          "default": 1
        },
        "qnxray.source": {
          "type": "string",
          "enum": [
            "",
            "pidin",
            "agent",
            "resmgr"
          ],
          "default": "",
          "description": "Snapshot source on an SSH target: pidin (default), agent (/tmp/qnxray-agent) or resmgr (/dev/qnxray resource manager)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile && node scripts/bundle-cli.js",
    "package": "vsce package --no-dependencies",
    "test": "node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suganthikannan093-hue/qnxray"
  },
  "icon": "media/icon.png"
}